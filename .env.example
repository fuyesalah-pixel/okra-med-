DATABASE_URL=postgresql://okra:okra@localhost:5432/okramed
# Platform control-plane connection. In production this must be a DISTINCT role
# with BYPASSRLS (okra_platform), because /api/platform/* reads across tenants
# while every tenant table is FORCE RLS. Falls back to DATABASE_URL in
# development only — that fallback uses the tenant role and MUST NOT ship to
# real tenants. See docs/architecture.md and docs/backlog.md (Phase 5 gate).
# PLATFORM_DATABASE_URL=postgresql://okra_platform:change-me@localhost:5432/okramed
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# --- Production-only vars (not needed for local dev) ---
# POSTGRES_PASSWORD is used by docker-compose.prod.yml for the postgres service.
# Traefik handles TLS and routing — no Caddy. The web container is on the
# okra-med-proxy external network; Traefik must be able to reach it there.
# Create the network once on the VPS: docker network create okra-med-proxy
# POSTGRES_PASSWORD=change-me-strong-password
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=okra-med-backups
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NODE_ENV=development
SEED_SUPER_ADMIN_EMAIL=admin@okramed.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_TENANT_SLUG=demo-clinic
SEED_TENANT_ADMIN_EMAIL=admin@demo-clinic.com
SEED_TENANT_ADMIN_PASSWORD=ChangeMe123!
NEXT_PUBLIC_APP_URL=http://localhost:3000
