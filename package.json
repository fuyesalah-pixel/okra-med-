{
  "name": "okra-med",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:rls": "vitest run apps/web/tests/rls.test.ts apps/web/tests/rls-guard.test.ts",
    "db:generate": "pnpm --filter @okra-med/db generate",
    "db:migrate": "pnpm --filter @okra-med/db migrate",
    "db:seed": "pnpm --filter @okra-med/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0"
  },
  "packageManager": "pnpm@9.15.0"
}
